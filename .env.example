# ===========================================
# SolarEdge Off-Grid Monitor: Konfiguration
# ===========================================
# Diese Datei nach .env kopieren und die Werte eintragen:
#   cp .env.example .env
#
# Pflichtwerte haben keinen Default; ohne sie startet die Anwendung nicht.
# Optionale Werte zeigen ihren Default und können gelöscht oder angepasst werden.

# -------------------------------------------
# SolarEdge-Anlage
# -------------------------------------------
# Optional: Die Anlagen-ID wird aus der Token-Datei gelesen.
# SOLAREDGE_SITE_ID=your_site_id_here

# -------------------------------------------
# SolarEdge API V2 (OAuth)
# -------------------------------------------
# Client-ID und Client-Secret der eigenen OAuth-App. Die Werte werden von
# scripts/solaredge_login.py auf den Pi geschrieben und nicht von Hand eingetragen.
SOLAREDGE_CLIENT_ID=your_client_id_here
SOLAREDGE_CLIENT_SECRET=your_client_secret_here
# Optional: Ort der Token-Datei (Default: .tokens.json im Projektverzeichnis)
# SOLAREDGE_TOKEN_FILE=/home/pi/solaredge-monitor/.tokens.json

# -------------------------------------------
# Solarprognose (optional)
# Nutzt die Forecast.Solar-API (kostenlos, kein API-Key nötig).
# Der Prognose-Bildschirm erscheint nur, wenn alle fünf Werte gesetzt sind.
# Die Zahlen unten sind Beispiele: eigene Koordinaten und eigene kWp eintragen.
# -------------------------------------------
# FORECAST_LAT=48.1351            # Breitengrad der Anlage (-90 bis 90)
# FORECAST_LON=11.5820            # Längengrad (-180 bis 180)
# FORECAST_TILT=30                # Neigung der Module in Grad (0 = waagerecht, 90 = senkrecht)
# FORECAST_AZIMUTH=0              # Ausrichtung (-180 bis 180; 0 = Süd, -90 = Ost, 90 = West)
# FORECAST_KWP=9.8                # Installierte Leistung in kWp

# -------------------------------------------
# Betrieb
# -------------------------------------------
# Minuten zwischen zwei Abfragen (Default 30, Minimum 30): jeder API-Aufruf kostet Kontingent
SOLAREDGE_POLL_INTERVAL=30
# Stunde, ab der der Nachtplan gilt (0-23, Default 20): Anzeige rotiert weiter, nur der Akku wird etwa alle 3 h abgefragt
SOLAREDGE_SLEEP_START=20
# Stunde, ab der der Tagesplan gilt (0-23, Default 7)
SOLAREDGE_SLEEP_END=7
# Tag im Monat, an dem das SolarEdge-Kontingent zurückgesetzt wird (1-31, Default 5; in kürzeren Monaten der letzte Tag)
# SOLAREDGE_BILLING_DAY=5
# Datei für den Aufrufzähler (Default: .calls.json neben der Token-Datei)
# SOLAREDGE_CALL_COUNTER_FILE=
# Debug-Modus: true/false (Default: false)
SOLAREDGE_DEBUG=false
# Log-Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Default: INFO)
SOLAREDGE_LOG_LEVEL=INFO

# Optionale Logdatei zusätzlich zum systemd-Journal (Default: keine, schont die
# SD-Karte). Beispiel: SOLAREDGE_LOG_FILE=solaredge_monitor.log
# SOLAREDGE_LOG_FILE=
